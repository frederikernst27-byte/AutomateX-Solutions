# Supabase (vorhanden)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# App URL (in Vercel automatisch, lokal http://localhost:3001)
NEXT_PUBLIC_APP_URL=https://maps.automate-x-solutions.de

# Google OAuth fuer Gmail-Integration
# -> Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# -> Authorized redirect URI: https://maps.automate-x-solutions.de/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenRouter API Key fuer KI-Email-Parsing (kostenlose Modelle verfuegbar)
# -> openrouter.ai/keys
OPENROUTER_API_KEY=
