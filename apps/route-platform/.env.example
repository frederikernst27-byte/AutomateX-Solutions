# Completely separate environment from apps/maps
NEXT_PUBLIC_APP_URL=http://localhost:3010
NEXT_PUBLIC_DEMO_MODE=false
# Keep false until every API repository is backed by the dedicated Supabase project.
SUPABASE_DATA_BACKEND_READY=false

# Session/authentication. Demo sessions are available only outside production.
# Set a strong random value for every shared development/staging environment.
AUTH_SECRET=
DEMO_AUTH_SECRET=replace-with-a-long-random-secret

# The process-local backend is blocked in production by default. These values
# are only for a controlled presentation URL with synthetic data.
PILOT_DEMO_BACKEND_ENABLED=false
PILOT_DEMO_ACKNOWLEDGEMENT=

# Dedicated Supabase project (EU region)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google services - server-side only
GOOGLE_MAPS_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Gmail KI-Inbox (OAuth Web Application)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Optional; defaults to NEXT_PUBLIC_APP_URL/api/integrations/gmail/callback
GMAIL_REDIRECT_URI=
# Random secret with at least 32 characters; encrypts stored refresh tokens.
INTEGRATION_ENCRYPTION_KEY=
GMAIL_SYNC_INTERVAL_MINUTES=5
GMAIL_LOOKBACK_DAYS=7
GMAIL_MAX_MESSAGES_PER_SYNC=25

# OpenAI-compatible text AI
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=

# Email
RESEND_API_KEY=
EMAIL_FROM=AutomateX Route <route@automate-x-solutions.de>
EMAIL_WEBHOOK_SECRET=
ALLOW_UNSIGNED_DEMO_WEBHOOK=false

# Worker
WORKER_POLL_INTERVAL_MS=3000

# VROOM route optimization (vroom-express HTTP endpoint)
VROOM_URL=http://localhost:3000
VROOM_TIMEOUT_MS=30000
# Optional bearer token when VROOM is behind an authenticated reverse proxy.
VROOM_API_KEY=
